# CivicLens — Environment Configuration
# Copy this file to .env.local and provide your Supabase project credentials.
# If these variables are not provided, CivicLens automatically operates in
# local in-memory seed data mode with full interactive workflows.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
